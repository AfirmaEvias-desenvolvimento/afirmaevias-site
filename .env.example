# Obrigatoria. No Railway o plugin Postgres injeta esta variavel sozinho.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/afirmaevias

# Admin inicial criado pela migration (so na primeira execucao)
ADMIN_EMAIL=admin@afirmaevias.com.br
ADMIN_PASSWORD=troque-esta-senha

# --- Opcionais: todas tem valor padrao, so configure se quiser mudar ---
# PORT=3000
# NODE_ENV=development            # no Railway e detectado automaticamente
# SESSION_SECRET=                 # gere com: openssl rand -hex 32
#                                 # sem ela o segredo e sorteado a cada boot e
#                                 # o painel desloga a cada redeploy
# ADMIN_NOME=Administrador
# SITE_URL=https://www.afirmaevias.com.br
# Link "Area do cliente" (portal do Comercial). Padrao: o endereco de producao
# atual. Troque aqui quando a URL mudar; vazio desliga o link; so aceita https.
# PORTAL_CLIENTE_URL=https://aevias-comercial-production.up.railway.app/

# --- Conexao 1 do hipersistema: contato do site vira lead no Comercial (src/comercial.ts) ---
# Desligada por padrao. Liga so com a URL do listener de servico do Comercial (https, mTLS) e os tres arquivos da
# identidade institucional-api. Sem Comercial no ar, os contatos ficam em fila e seguem no /admin normalmente.
# COMERCIAL_API_URL=https://comercial.interno:9548
# COMERCIAL_MTLS_CA=/caminho/ca.crt
# COMERCIAL_MTLS_CERT=/caminho/api.crt
# COMERCIAL_MTLS_KEY=/caminho/api.key
# COMERCIAL_FILA_INTERVALO_MS=60000

# --- Avisos por e-mail (src/notificacoes.ts) ---
# Sem RESEND_API_KEY o envio e ignorado e os registros ficam so no /admin
# RESEND_API_KEY=
# EMAIL_REMETENTE=site@afirmaevias.com.br
# EMAIL_CONTATO=comercial@afirmaevias.com.br
# EMAIL_RH=comercial@afirmaevias.com.br
# EMAIL_COMPLIANCE=comercial@afirmaevias.com.br
# EMAIL_ENCARREGADO=privacidade@afirmaevias.com.br

# --- Feed do RH (produtor 'institucional', src/integracao-servidor.ts; docs/hipersistema/feed-rh-institucional.md) ---
# Listener mTLS proprio. Sem INTEGRACAO_PORT nada sobe. Quem chama: so rh-collector; o AUTH confirma feed.read a cada chamada.
# INTEGRACAO_PORT=4807
# INTEGRACAO_HOST=127.0.0.1
# INTEGRACAO_TLS_CERT=/caminho/servidor.crt
# INTEGRACAO_TLS_KEY=/caminho/servidor.key
# INTEGRACAO_MTLS_CA=/caminho/ca.crt
# INTEGRACAO_AUTH_URL=https://auth.interno:9999
# INTEGRACAO_CLIENT_CERT=/caminho/institucional-api.crt   (padrao: COMERCIAL_MTLS_CERT)
# INTEGRACAO_CLIENT_KEY=/caminho/institucional-api.key    (padrao: COMERCIAL_MTLS_KEY)
# INTEGRACAO_CURSOR_KEY=                                  (padrao: SESSION_SECRET)
