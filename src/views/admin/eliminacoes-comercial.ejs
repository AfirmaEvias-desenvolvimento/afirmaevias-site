<%- include('topo') %>

<header class="topo-conteudo">
  <div>
    <p class="sobrancelha-admin">Privacidade</p>
    <h1 class="titulo-admin">Eliminações no Comercial</h1>
  </div>
</header>

<div class="corpo">
  <% if (aviso === 'novo') { %>
    <div class="faixa-alerta">Contato excluído no Site. Confirme abaixo a eliminação do pedido correspondente no Comercial.</div>
  <% } else if (aviso === 'concluida') { %>
    <div class="faixa-alerta">O Comercial confirmou a eliminação do pedido.</div>
  <% } else if (aviso === 'vinculada') { %>
    <div class="faixa-alerta">Pedido vinculado a um registro comercial. Encaminhe o código ao responsável pelo tratamento. A pendência continua aberta.</div>
  <% } else if (aviso === 'nao_confirmada') { %>
    <div class="faixa-alerta">O Comercial não confirmou a eliminação. A pendência continua aberta para nova tentativa.</div>
  <% } %>

  <section class="cartao-admin">
    <h2 class="cartao-admin__titulo">O que fazer</h2>
    <p class="secundario">Use <strong>Eliminar no Comercial</strong> para enviar o pedido pelo código abaixo. A pendência só é encerrada após a confirmação do Comercial.</p>
    <p class="secundario">Se houver vínculo com um cliente ou uma conversão, localize o código em <strong>Solicitações dos clientes</strong> no Comercial e encaminhe ao responsável pelo tratamento.</p>
  </section>

  <div class="tabela-envolvida-admin">
    <table class="tabela-admin tabela-admin--lista">
      <thead>
        <tr><th>Pedido em</th><th>Código do lead no Comercial</th><th>Origem</th><th>Registrado por</th><th>Situação</th><th></th></tr>
      </thead>
      <tbody>
        <% if (pendencias.length === 0) { %>
          <tr><td colspan="6" class="vazio">Nenhuma eliminação pendente nem concluída.</td></tr>
        <% } %>
        <% pendencias.forEach(function (p) { %>
          <tr>
            <td class="mono"><%= new Date(p.pedido_em).toLocaleString('pt-BR') %></td>
            <td class="mono"><%= p.lead_id %></td>
            <td><%= p.origem === 'painel' ? 'Exclusão pelo painel' : 'Retenção automática' %></td>
            <td><%= p.origem === 'painel' ? (p.registrado_por_nome || '—') : 'sistema' %></td>
            <td>
              <% if (p.status === 'pendente') { %>
                <span class="etiqueta etiqueta--acao">pendente</span>
              <% } else { %>
                concluída em <%= new Date(p.concluida_em).toLocaleString('pt-BR') %><% if (p.concluida_por_nome) { %> por <%= p.concluida_por_nome %><% } %>
              <% } %>
            </td>
            <td>
              <% if (p.status === 'pendente' && usuario.papel === 'admin') { %>
                <form method="post" action="/admin/eliminacoes-comercial/<%= p.id %>/concluir" data-confirmar="Confirma a eliminação deste pedido no Comercial?">
                  <button type="submit" class="botao-admin botao-admin--fantasma">Eliminar no Comercial</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('rodape') %>
