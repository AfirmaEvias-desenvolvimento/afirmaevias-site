</main>

<footer class="rodape">
  <div class="rodape__faixa" aria-hidden="true"></div>
  <div class="conteiner rodape__grade">

    <div class="rodape__marca">
      <img src="/img/logo-vertical-claro.webp" alt="Afirma E-vias" width="160" height="79">
      <p class="rodape__lema">Abrindo caminhos,<br>construindo o futuro.</p>
    </div>

    <div class="rodape__bloco rodape__bloco--contato">
      <h2 class="rodape__titulo">Fale com a gente</h2>
      <ul class="rodape__lista">
        <li><a href="https://wa.me/<%= empresa.whatsapp %>" target="_blank" rel="noopener"><svg class="icone" aria-hidden="true"><use href="#i-conversa"/></svg><%= empresa.telefoneCelular %> · WhatsApp</a></li>
        <li><a href="tel:+554131238550"><svg class="icone" aria-hidden="true"><use href="#i-telefone"/></svg><%= empresa.telefoneFixo %></a></li>
        <li><a href="mailto:<%= empresa.email %>"><svg class="icone" aria-hidden="true"><use href="#i-email"/></svg><%= empresa.email %></a></li>
      </ul>
    </div>

    <div class="rodape__bloco">
      <h2 class="rodape__titulo">Nossos canais</h2>
      <ul class="rodape__lista rodape__lista--chips">
        <li><a href="<%= empresa.linkedin %>" target="_blank" rel="noopener"><svg class="icone" aria-hidden="true"><use href="#i-linkedin"/></svg>LinkedIn</a></li>
        <li><a href="<%= empresa.instagram %>" target="_blank" rel="noopener"><svg class="icone" aria-hidden="true"><use href="#i-instagram"/></svg>Instagram</a></li>
        <% if (portalClienteUrl) { %><li><a href="<%= portalClienteUrl %>" rel="noopener noreferrer">Área do cliente</a></li><% } %>
        <li><a href="/trabalhe-com-a-gente">Trabalhe com a gente</a></li>
        <li><a href="/programa-de-integridade#canal">Canal de denúncias</a></li>
      </ul>
    </div>

    <div class="rodape__bloco">
      <h2 class="rodape__titulo">Endereços</h2>
      <ul class="rodape__lista rodape__lista--enderecos">
        <% empresa.enderecos.forEach(function (endereco) { %>
          <li>
            <a href="<%= endereco.mapsUrl %>" target="_blank" rel="noopener" aria-label="Abrir localização de <%= endereco.cidade %> no Google Maps">
              <span class="rodape__cidade"><%= endereco.cidade %>/<%= endereco.uf %></span>
              <%= endereco.linha1 %><br><%= endereco.linha2 %>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="conteiner rodape__base">
    <p>© <%= new Date().getFullYear() %> <%= empresa.razaoSocial %> · CNPJ <%= empresa.cnpj %></p>
    <nav class="rodape__legal" aria-label="Links legais">
      <a href="/politica-de-privacidade">Política de privacidade</a>
      <a href="/termos-de-uso">Termos de uso</a>
      <a href="/acessibilidade">Acessibilidade</a>
      <a href="/portal-do-titular">Portal do titular (LGPD)</a>
      <button type="button" class="rodape__link-botao" data-abrir-cookies>Preferências de cookies</button>
    </nav>
  </div>
</footer>

<div class="flutuantes">
  <button type="button" class="flutuante flutuante--topo" data-voltar-topo aria-label="Voltar ao topo da página">
    <svg class="anel" viewBox="0 0 36 36" aria-hidden="true">
      <circle class="anel__trilha" cx="18" cy="18" r="15.9155"/>
      <circle class="anel__progresso" cx="18" cy="18" r="15.9155" pathLength="100"/>
    </svg>
    <svg class="icone" aria-hidden="true"><use href="#i-topo"/></svg>
  </button>
  <a class="flutuante flutuante--whatsapp" href="https://wa.me/<%= empresa.whatsapp %>" target="_blank" rel="noopener" aria-label="Conversar pelo WhatsApp">
    <svg class="icone" aria-hidden="true"><use href="#i-conversa"/></svg>
  </a>
</div>

<div class="cookies" id="cookies" hidden>
  <div class="cookies__caixa" role="dialog" aria-modal="false" aria-labelledby="cookies-titulo">
    <% var opcionais = cookiesCategorias.filter(function (c) { return !c.obrigatorio; }); %>
    <% if (opcionais.length === 0) { %>
      <p class="cookies__texto" id="cookies-titulo">Usamos apenas o essencial para o site funcionar. Não medimos audiência nem fazemos publicidade. <a href="/politica-de-privacidade">Política de privacidade</a>.</p>

      <div class="cookies__acoes cookies__acoes--principal">
        <button type="button" class="botao botao--verde" data-cookies="recusar">Entendi</button>
      </div>
    <% } else { %>
      <p class="cookies__texto" id="cookies-titulo">Usamos cookies para o site funcionar e, com sua permissão, medir audiência. <a href="/politica-de-privacidade">Política de privacidade</a>.</p>

      <div class="cookies__acoes cookies__acoes--principal">
        <button type="button" class="cookies__link" data-cookies="ajustar">Personalizar</button>
        <button type="button" class="botao botao--fantasma" data-cookies="recusar">Só essenciais</button>
        <button type="button" class="botao botao--verde" data-cookies="aceitar">Aceitar</button>
      </div>
    <% } %>

    <div class="cookies__opcoes" id="cookies-opcoes" hidden>
      <% opcionais.forEach(function (categoria) { %>
        <label class="cookies__opcao">
          <input type="checkbox" name="<%= categoria.chave %>">
          <span><%= categoria.titulo %></span>
        </label>
      <% }); %>

      <div class="cookies__acoes">
        <button type="button" class="cookies__link" data-cookies="voltar">Voltar</button>
        <button type="button" class="botao botao--verde" data-cookies="salvar">Salvar</button>
      </div>
    </div>
  </div>
</div>

<script src="<%= asset('/js/site.js') %>" defer></script>
<script src="<%= asset('/js/cookies.js') %>" defer></script>
</body>
</html>
